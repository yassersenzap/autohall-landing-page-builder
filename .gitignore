.env
.env.local
.env.*.local
.env.*
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.vite/
vite.config.ts.timestamp-*
**/dist/
**/build/

# NestJS / TypeScript
*.tsbuildinfo

# Testing / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Prisma
*.db
*.db-journal
backend/generated/
**/generated/prisma/

# OS
.DS_Store
Thumbs.db
Desktop.ini
