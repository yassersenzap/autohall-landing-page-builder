# ============================================================
# AutoHall LP Builder — racine du dépôt
# ============================================================

# Dependencies
node_modules/

# Environment and secrets (never commit real .env files)
.env
.env.*
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.vite/

# NestJS / TypeScript
*.tsbuildinfo

# Testing / coverage
coverage/
.nyc_output/

# Prisma
*.db
*.db-journal
**/generated/prisma/

# OS
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# IDE / editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# Cursor / local tooling
.cursor/

# Local storage (exports, uploads, assets générés)
storage/
uploads/
exports/

# Temporary files
tmp/
temp/
*.tmp
*.temp
.cache/
.playwright-cli/
docs-private/
