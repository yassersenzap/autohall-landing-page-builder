# =============================================================================
# FRONTEND .env — développement local Vite uniquement (hors Docker)
# =============================================================================
# Copier : cp .env.example .env
# Ne jamais committer le fichier .env réel.
#
# Pour Docker / SI : configurer VITE_API_BASE_URL dans le .env RACINE
# (injecté au build de l'image frontend via docker-compose).
# =============================================================================

VITE_API_BASE_URL=http://localhost:3000
