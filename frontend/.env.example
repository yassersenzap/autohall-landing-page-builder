# API backend — injectée au build Vite (npm run dev / npm run build)
# En Docker : passée via docker-compose build arg VITE_API_BASE_URL (voir ../.env.example)

# Développement local
VITE_API_BASE_URL=http://localhost:3000

# Exemple SI interne (documentation — mettre la même valeur dans ../.env pour docker compose build) :
# VITE_API_BASE_URL=http://10.100.8.10:3000
