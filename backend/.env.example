# =============================================================================
# BACKEND .env — développement local NestJS / Prisma (hors Docker applicatif)
# =============================================================================
# Copier : cp .env.example .env
# Ne jamais committer le fichier .env réel.
#
# PostgreSQL : lancer uniquement le service DB si besoin :
#   docker compose up -d postgres
# DATABASE_URL utilise localhost (port exposé par Compose).
#
# Déploiement Docker complet → utiliser le .env RACINE, pas ce fichier.
# =============================================================================

NODE_ENV=development
BACKEND_PORT=3000

DATABASE_URL=postgresql://autohall_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/autohall_lp_builder?schema=public

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Origine du frontend Vite en dev (port 5173 par défaut)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL publique de l'API (exports ZIP, assets) vue depuis le navigateur
PUBLIC_API_BASE_URL=http://localhost:3000

# Seed (npm run db:seed)
SEED_ADMIN_EMAIL=admin@autohall.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_12_CHARS
