# =============================================================================
# Backend NestJS — développement local (hors Docker applicatif)
# =============================================================================
# Recommandé : utiliser le .env à la racine du dépôt (voir ../.env.example).
# Ce fichier sert de surcharge locale optionnelle (backend/.env).

NODE_ENV=development
BACKEND_PORT=3000

# PostgreSQL sur l'hôte (docker compose up -d postgres uniquement, ou Postgres local)
DATABASE_URL=postgresql://autohall_user:change-me-use-a-strong-password@localhost:5432/autohall_lp_builder?schema=public

# CORS — origines du frontend Vite en dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

PUBLIC_API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Déploiement Docker complet : ne pas utiliser localhost ici.
# Configurer ../.env avec DATABASE_URL host=postgres et lancer :
#   docker compose up -d
# -----------------------------------------------------------------------------
