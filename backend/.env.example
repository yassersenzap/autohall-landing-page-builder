# Copier vers backend/.env OU utiliser le .env à la racine du dépôt (recommandé).
# Les variables du fichier racine sont chargées en premier ; backend/.env peut surcharger localement.

# Application
NODE_ENV=development
BACKEND_PORT=3000

# Database (PostgreSQL — Docker local)
DATABASE_URL=postgresql://autohall_user:change-me-local-dev@localhost:5432/autohall_lp_builder?schema=public

# CORS — comma-separated origins for the builder frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (required for authentication)
JWT_SECRET=replace-with-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
