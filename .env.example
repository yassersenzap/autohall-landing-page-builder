# Generic
NODE_ENV=development

# Ports (local development)
BACKEND_PORT=3000
FRONTEND_PORT=5173

# PostgreSQL (Docker — copy to .env and set real local values)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autohall_lp_builder
POSTGRES_USER=autohall_user
POSTGRES_PASSWORD=change-me-local-dev

# pgAdmin (optional, local development — profile pgadmin)
PGADMIN_DEFAULT_EMAIL=admin@autohall.local
PGADMIN_DEFAULT_PASSWORD=change-me-local-dev
PGADMIN_PORT=5050

# Database URL for backend / Prisma (host machine → Docker PostgreSQL)
DATABASE_URL=postgresql://autohall_user:change-me-local-dev@localhost:5432/autohall_lp_builder

# Auth (JWT) — use long random strings in real environments; never commit real secrets
JWT_SECRET=replace-with-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins for the builder frontend, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server paths for generated ZIPs and uploaded assets (absolute or app-relative as decided in implementation)
EXPORT_STORAGE_PATH=./storage/exports
ASSETS_STORAGE_PATH=./storage/assets
ASSETS_MAX_FILE_SIZE=5242880

# Frontend (Vite) — public API base URL for the builder
VITE_API_BASE_URL=http://localhost:3000
