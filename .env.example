# =============================================================================
# AutoHall LP Builder — Docker Compose / déploiement SI
# Copier vers .env à la racine du dépôt : cp .env.example .env
# Ne jamais committer le fichier .env réel.
# =============================================================================

NODE_ENV=production

# Ports exposés sur l'hôte (frontend Nginx écoute 80 dans le conteneur)
FRONTEND_PORT=8080
BACKEND_PORT=3000
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# PostgreSQL (service Docker : postgres)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_DB=autohall_lp_builder
POSTGRES_USER=autohall_user
POSTGRES_PASSWORD=change-me-use-a-strong-password

# Backend Prisma — hôte DOIT être "postgres" en Docker (pas localhost)
DATABASE_URL=postgresql://autohall_user:change-me-use-a-strong-password@postgres:5432/autohall_lp_builder?schema=public

# -----------------------------------------------------------------------------
# Auth backend
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# URLs vues depuis le navigateur (builder React + API publique exports/assets)
# -----------------------------------------------------------------------------
# Développement local (docker compose par défaut) :
#   Frontend : http://localhost:8080  (FRONTEND_PORT → Nginx :80)
#   Backend  : http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080
PUBLIC_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Exemple déploiement SI interne (documentation uniquement — adapter dans .env) :
#   Frontend : http://10.100.8.10/        si FRONTEND_PORT=80
#   Frontend : http://10.100.8.10:8080/   si FRONTEND_PORT=8080 (défaut compose)
#   Backend  : http://10.100.8.10:3000    (API directe, pas de proxy /api dans Nginx)
# CORS_ALLOWED_ORIGINS=http://10.100.8.10,http://10.100.8.10:8080
# PUBLIC_API_BASE_URL=http://10.100.8.10:3000
# VITE_API_BASE_URL=http://10.100.8.10:3000

# -----------------------------------------------------------------------------
# Stockage backend (valeurs par défaut dans docker-compose ; surcharge optionnelle)
# -----------------------------------------------------------------------------
# ASSETS_STORAGE_PATH=/app/storage/assets
# EXPORT_STORAGE_PATH=/app/storage/exports
# ASSETS_MAX_FILE_SIZE=5242880

# -----------------------------------------------------------------------------
# pgAdmin (profil optionnel : docker compose --profile pgadmin up -d)
# -----------------------------------------------------------------------------
# PGADMIN_PORT=5050
# PGADMIN_DEFAULT_EMAIL=admin@autohall.local
# PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
