# Generic
NODE_ENV=development

# Ports (local development)
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Database (PostgreSQL) — replace user, password, host, port, database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autohall_lp_builder
POSTGRES_DB=autohall_lp_builder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Auth (JWT) — use long random strings in real environments; never commit real secrets
JWT_SECRET=replace-with-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins for the builder frontend, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server paths for generated ZIPs and uploaded assets (absolute or app-relative as decided in implementation)
EXPORT_STORAGE_PATH=./storage/exports
ASSETS_STORAGE_PATH=./storage/assets

# Frontend (Vite) — public API base URL for the builder
VITE_API_BASE_URL=http://localhost:3000
