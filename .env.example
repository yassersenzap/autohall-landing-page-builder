# Application (Docker Compose — copier .env.example vers .env à la racine)
NODE_ENV=production
BACKEND_PORT=3000
FRONTEND_PORT=8080

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autohall_lp_builder
POSTGRES_USER=autohall_user
POSTGRES_PASSWORD=change-me-local-dev

# Backend (réseau Docker interne)
DATABASE_URL=postgresql://autohall_user:change-me-local-dev@postgres:5432/autohall_lp_builder?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS — URL du frontend servi par Nginx (port hôte par défaut 8080)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# API publique (exports ZIP, assets) — URL vue depuis le navigateur
PUBLIC_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
