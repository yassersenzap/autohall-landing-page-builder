# =============================================================================
# ROOT .env — Docker Compose / déploiement SI uniquement
# =============================================================================
# Copier : cp .env.example .env
# Ne jamais committer le fichier .env réel.
#
# Ce fichier n'est PAS utilisé par :
#   - npm run dev (frontend) → voir frontend/.env
#   - npm run start:dev (backend) → voir backend/.env
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# Ports exposés sur l'hôte
# -----------------------------------------------------------------------------
# Local Docker (évite conflits si 3000/8080 occupés) :
FRONTEND_PORT=8081
BACKEND_PORT=3001
POSTGRES_PORT=5432

# SI interne (ex. http://10.100.8.10/) :
# FRONTEND_PORT=80
# BACKEND_PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (service Docker : postgres)
# -----------------------------------------------------------------------------
POSTGRES_DB=autohall_lp_builder
POSTGRES_USER=autohall_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Prisma / backend dans Docker — hôte DOIT être "postgres" (jamais localhost)
DATABASE_URL=postgresql://autohall_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/autohall_lp_builder?schema=public

# -----------------------------------------------------------------------------
# Auth backend (conteneur)
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Seed initial (docker compose exec backend npm run db:seed)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@autohall.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_12_CHARS

# -----------------------------------------------------------------------------
# URLs vues depuis le navigateur (builder + API publique exports/assets)
# -----------------------------------------------------------------------------
# Local Docker (ports ci-dessus) :
CORS_ALLOWED_ORIGINS=http://localhost:8081
PUBLIC_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# SI interne 10.100.8.10 (documentation — décommenter et adapter dans .env) :
# CORS_ALLOWED_ORIGINS=http://10.100.8.10,http://10.100.8.10:8080
# PUBLIC_API_BASE_URL=http://10.100.8.10:3000
# VITE_API_BASE_URL=http://10.100.8.10:3000

# -----------------------------------------------------------------------------
# Optionnel — surcharge des valeurs par défaut docker-compose.yml
# -----------------------------------------------------------------------------
# ASSETS_STORAGE_PATH=/app/storage/assets
# EXPORT_STORAGE_PATH=/app/storage/exports
# ASSETS_MAX_FILE_SIZE=5242880

# pgAdmin (profil : docker compose --profile pgadmin up -d)
# PGADMIN_PORT=5050
# PGADMIN_DEFAULT_EMAIL=admin@autohall.local
# PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
